# Copy to `.env` and fill in what you need. Every value here can also be
# overridden per-invocation with the matching `jev-plays-pokemon` CLI flag
# (see `src/jev_plays_pokemon/settings.py`, docs/adr/0001-...); CLI flag >
# this file's value > unset.

# Required for Jev's tactical decisions (typesafe_sdk).
TYPESAFE_API_KEY=

# Base URL of a llama-server running Jeff (Qwen3.5-2B), e.g.
# http://127.0.0.1:8098. When set, Jeff decides each turn instead of Jev and
# TYPESAFE_API_KEY is not needed.
JEFF_URL=

# Vision-fallback dialog decode (see dialog_vision.py). Only needed when
# DIALOG_DECODE_BACKEND is explicitly set to "vision-llm".
OPENAI_API_KEY=
# Base URL of an OpenAI-compatible endpoint, e.g. a self-hosted sglang
# server. Leave unset to target the real OpenAI API (OPENAI_API_KEY then
# becomes required).
OPENAI_BASE_URL=
# No provider-specific default is hardcoded; must be set for the vision-llm
# backend to work.
OPENAI_VISION_MODEL=

# "rapidocr" (default) or "vision-llm" - see dialog_decode.py.
DIALOG_DECODE_BACKEND=
